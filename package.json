{
  "name": "poleline",
  "version": "0.1.0",
  "description": "Draw your racing line around real F1 circuits and chase pole position.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tracks:build": "tsx scripts/build-tracks.ts",
    "tracks:calibrate": "tsx scripts/calibrate.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@upstash/redis": "^1.39.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
